{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheus.local/schemas/bundle.schema.json",
  "title": "PROMETHEUS Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "license", "roles", "permissions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "license": {
      "type": "object",
      "required": ["spdx", "url"],
      "properties": {"spdx": {"type": "string"}, "url": {"type": "string", "format": "uri"}}
    },
    "roles": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "mcpServers": {"type": "array", "items": {"type": "object"}},
    "prompts": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "signature": {"type": "object"}
  }
}

