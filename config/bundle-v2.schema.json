{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROMETHEUS selectable model bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "description", "hardware", "runtime", "roles", "licenses", "qualification"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "recommended_for": {"type": "array", "items": {"type": "string"}},
    "hardware": {"type": "object"},
    "runtime": {"type": "object"},
    "roles": {"type": "object"},
    "licenses": {"type": "array", "items": {"type": "object"}},
    "qualification": {"type": "object"},
    "experimental": {"type": "boolean"}
  }
}
